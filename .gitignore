# ---------------------------------------------------------------------------
# Dépôt du dossier APIX / PPC
#
# Les livrables de dist/ sont versionnés volontairement : ils sont le produit
# fini présenté à PPC. Ils restent regénérables à tout moment par
#   python outils\build_docs.py
#   python outils\build_xlsx.py
# Pour ne plus les versionner (et alléger le dépôt), décommenter la ligne ci-dessous.
# ---------------------------------------------------------------------------
# dist/

# Notes internes — comptes rendus de réunion, transcriptions.
# Jamais versionnées : le dépôt est public et contient des informations sur PPC
# et sur des tiers. Décommenter pour les publier volontairement.
/prive/

# Fichiers temporaires de bureautique
~$*
*- Copie.pptx
*.tmp
Thumbs.db
desktop.ini
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Éditeurs
.vscode/
.idea/

# Archive de livraison : regenerable par outils\build_livraison.ps1, 14 Mo, ne pas versionner
dist/livraison/*.zip
